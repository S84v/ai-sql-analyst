erDiagram
    customers {
        text customer_id PK "per-order customer record"
        text customer_unique_id "persistent buyer identity"
        text customer_zip_code_prefix
        text customer_city
        text customer_state
    }
    sellers {
        text seller_id PK
        text seller_zip_code_prefix
        text seller_city
        text seller_state
    }
    products {
        text product_id PK
        text product_category_name "intentionally not FK-linked to translation"
        integer product_name_lenght
        integer product_description_lenght
        integer product_photos_qty
        integer product_weight_g
        integer product_length_cm
        integer product_height_cm
        integer product_width_cm
    }
    product_category_translation {
        text product_category_name PK
        text product_category_name_english
    }
    geolocation {
        bigint geolocation_id PK
        text geolocation_zip_code_prefix "many rows per ZIP; not FK-linked"
        numeric geolocation_lat
        numeric geolocation_lng
        text geolocation_city
        text geolocation_state
    }
    orders {
        text order_id PK
        text customer_id FK
        text order_status
        timestamp order_purchase_timestamp "naive, no timezone"
        timestamp order_approved_at
        timestamp order_delivered_carrier_date
        timestamp order_delivered_customer_date
        timestamp order_estimated_delivery_date
    }
    order_items {
        text order_id PK,FK
        integer order_item_id PK "unique only within order"
        text product_id FK
        text seller_id FK
        timestamp shipping_limit_date
        numeric price
        numeric freight_value
    }
    order_payments {
        text order_id PK,FK
        integer payment_sequential PK "sequence within order; composite key"
        text payment_type
        integer payment_installments
        numeric payment_value
    }
    order_reviews {
        text review_id PK "not globally unique"
        text order_id PK,FK
        smallint review_score
        text review_comment_title
        text review_comment_message
        timestamp review_creation_date
        timestamp review_answer_timestamp
    }

    customers ||--o{ orders : places
    orders ||--o{ order_items : contains
    orders ||--o{ order_payments : "has payments"
    orders ||--o{ order_reviews : "has reviews"
    products ||--o{ order_items : "appears in"
    sellers ||--o{ order_items : supplies
